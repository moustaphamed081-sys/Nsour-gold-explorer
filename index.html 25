        let cls = "";
        if(key === "au_grade_ppm" && Number(val) >= 1) cls = "value-high";
        if(key === "au_reported_text" && String(val).startsWith("<")) cls = "value-bdl";
        return '<td class="'+cls+'">'+esc(val)+'</td>';
      }).join("") + "</tr>").join("");
    }
    el("datasetMeta").textContent = cfg.label + " · " + rows.length + " ligne(s) affichée(s)";
  }

  async function load(dataset){
    current = dataset;
    const cfg = configs[current];
    currentRows = cfg.fallback.slice();
    el("datasetStatus").textContent = "Chargement…";
    render();

    const select = cfg.columns.map(c=>c[0]).join(",");
    try{
      const url = API + "/" + cfg.table + "?select=" + encodeURIComponent(select) + "&permit_key=eq.NSOUR&order=" + encodeURIComponent(cfg.order) + "&limit=100";
      const res = await fetch(url,{headers:{"Accept":"application/json"}});
      if(!res.ok) throw new Error("HTTP "+res.status);
      const rows = await res.json();
      if(Array.isArray(rows) && rows.length){
        currentRows = rows;
        el("datasetStatus").textContent = "Données chargées depuis Neon · jusqu'à 100 lignes.";
      }else{
        el("datasetStatus").textContent = "Aperçu vérifié affiché.";
      }
    }catch(e){
      el("datasetStatus").textContent = "RLS protège la lecture publique · aperçu vérifié affiché.";
    }
    render();
  }

  document.querySelectorAll(".dataset-tab").forEach(btn => btn.addEventListener("click",()=>{
    document.querySelectorAll(".dataset-tab").forEach(b=>b.classList.remove("active"));
    btn.classList.add("active");
    el("datasetSearch").value = "";
    load(btn.dataset.dataset);
  }));

  el("datasetSearch")?.addEventListener("input",render);
  document.querySelector('nav button[data-page="data"]')?.addEventListener("click",()=>load(current));
  render();
})();
</script>

<script type="module">
const DATA_API_URL = "https://ep-noisy-shape-b6n7qbka.apirest.c-7.us-east-2.aws.neon.tech/neondb/rest/v1";

const $ = id => document.getElementById(id);

async function exactCount(table){
  const res = await fetch(`${DATA_API_URL}/${table}?select=*&limit=1`, {
    headers: {
      "Accept": "application/json",
      "Prefer": "count=exact"
    }
  });
  if(!res.ok) throw new Error(`HTTP ${res.status}`);
  const range = res.headers.get("content-range") || "";
  const m = range.match(/\/(\d+)$/);
  return m ? Number(m[1]) : null;
}

async function loadPublicData(){
  try{
    const [als,qc,tr,rc] = await Promise.all([
      exactCount("explorer_als_results"),
      exactCount("explorer_als_qc"),
      exactCount("explorer_trenches"),
      exactCount("explorer_rc_intercepts")
    ]);

    if(Number.isFinite(als)) $("alsCount").textContent = als.toLocaleString("fr-FR");
    if(Number.isFinite(qc)) $("qcCount").textContent = qc.toLocaleString("fr-FR");
    if(Number.isFinite(tr)) $("trenchCount").textContent = tr.toLocaleString("fr-FR");
    if(Number.isFinite(rc)) $("rcCount").textContent = rc.toLocaleString("fr-FR");

    $("dataState").textContent = "données Neon";
    $("connectionStatus").textContent = "● Neon : lecture";
  }catch(e){
    // Keep the verified reference totals already shown in the page.
    $("dataState").textContent = "référentiel Nsour";
    $("connectionStatus").textContent = "● Mode lecture";
  }
}

loadPublicData();
</script>
