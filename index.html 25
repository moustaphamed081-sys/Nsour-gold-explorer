      ],
      fallback:[
        {control_name:"BLANK",project_code:"MMM-24-01",workorder:"LR25047038",au_reported_text:"<0.01",au_value_or_limit_ppm:0.01,qualifier:"<"},
        {control_name:"BLANK",project_code:"MMM-24-01",workorder:"LR25047038",au_reported_text:"<0.01",au_value_or_limit_ppm:0.01,qualifier:"<"},
        {control_name:"CT-22",project_code:"MMM-24-01",workorder:"LR25047038",au_reported_text:"2.60",au_value_or_limit_ppm:2.6,qualifier:"Reported"},
        {control_name:"CT-22",project_code:"MMM-24-01",workorder:"LR25047038",au_reported_text:"2.50",au_value_or_limit_ppm:2.5,qualifier:"Reported"},
        {control_name:"NTR0006-DUP",project_code:"MMM-24-01",workorder:"LR25047038",au_reported_text:"0.01",au_value_or_limit_ppm:0.01,qualifier:"Reported"},
        {control_name:"NTR0044-DUP",project_code:"MMM-24-01",workorder:"LR25047038",au_reported_text:"0.01",au_value_or_limit_ppm:0.01,qualifier:"Reported"}
