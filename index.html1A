ercepts": [{"from_m": 32, "to_m": 37, "thickness_calc_m": 5, "au_grade_ppm": 1.73, "note": null}]}, {"hole_id": "12NSRC070", "zone_name": "Conchita Sud", "reassays": [], "intercepts": [{"from_m": 76, "to_m": 79, "thickness_calc_m": 3, "au_grade_ppm": 2.81, "note": null}]}, {"hole_id": "12NSRC067", "zone_name": "Conchita Sud", "reassays": [], "intercepts": [{"from_m": 19, "to_m": 22, "thickness_calc_m": 3, "au_grade_ppm": 0.89, "note": null}]}, {"hole_id": "12NSRC064", "zone_name": "Conchita Sud", "reassays": [], "intercepts": [{"from_m": 7, "to_m": 18, "thickness_calc_m": 11, "au_grade_ppm": 1.24, "note": null}]}, {"hole_id": "12NSRC063", "zone_name": "Conchita Sud", "reassays": [], "intercepts": [{"from_m": 46, "to_m": 49, "thickness_calc_m": 3, "au_grade_ppm": 1.47, "note": null}, {"from_m": 136, "to_m": 139, "thickness_calc_m": 3, "au_grade_ppm": 2.17, "note": null}]}, {"hole_id": "11NSRC028", "zone_name": "Conchita Sud", "reassays": [], "intercepts": [{"from_m": 21, "to_m": 27, "thickness_calc_m": 6, "au_grade_ppm": 1.71, "note": null}]}, {"hole_id": "11NSRC029", "zone_name": "Conchita Sud", "reassays": [], "intercepts": [{"from_m": 21, "to_m": 29, "thickness_calc_m": 8, "au_grade_ppm": 0.87, "note": null}, {"from_m": 39, "to_m": 42, "thickness_calc_m": 3, "au_grade_ppm": 2.14, "note": null}]}, {"hole_id": "11NSRC034", "zone_name": "Conchita Sud", "reassays": [], "intercepts": [{"from_m": 17, "to_m": 20, "thickness_calc_m": 3, "au_grade_ppm": 0.55, "note": null}]}, {"hole_id": "11NSRC032", "zone_name": "Conchita Sud", "reassays": [], "intercepts": [{"from_m": 22, "to_m": 25, "thickness_calc_m": 3, "au_grade_ppm": 2.37, "note": null}]}, {"hole_id": "11NSRC031", "zone_name": "Conchita Sud", "reassays": [], "intercepts": [{"from_m": 25, "to_m": 28, "thickness_calc_m": 3, "au_grade_ppm": 0.95, "note": null}]}, {"hole_id": "11NSRC035", "zone_name": "Conchita Sud", "reassays": [], "intercepts": [{"from_m": 33, "to_m": 36, "thickness_calc_m": 3, "au_grade_ppm": 1.04, "note": "La colonne suivante du tableau semble afficher 3,00 à 0,95; divergence conservée en note."}]}, {"hole_id": "12NSRC073", "zone_name": "Conchita Sud", "reassays": [], "intercepts": [{"from_m": 25, "to_m": 28, "thickness_calc_m": 3, "au_grade_ppm": 1.14, "note": null}, {"from_m": 32, "to_m": 35, "thickness_calc_m": 3, "au_grade_ppm": 0.6, "note": null}]}, {"hole_id": "11NSRC018", "zone_name": "Conchita Sud", "reassays": [], "intercepts": [{"from_m": 30, "to_m": 33, "thickness_calc_m": 3, "au_grade_ppm": 0.57, "note": null}]}, {"hole_id": "11NSRC019", "zone_name": "Conchita Sud", "reassays": [], "intercepts": [{"from_m": 43, "to_m": 46, "thickness_calc_m": 3, "au_grade_ppm": 2.15, "note": null}, {"from_m": 75, "to_m": 78, "thickness_calc_m": 3, "au_grade_ppm": 2.87, "note": null}]}, {"hole_id": "11NSRC013", "zone_name": "Conchita Sud", "reassays": [], "intercepts": [{"from_m": 12, "to_m": 18, "thickness_calc_m": 6, "au_grade_ppm": 1.27, "note": null}]}];
    function drawRows(rows, sourceLabel){
      trenchMarkers = [];
      trenchLayer.clearLayers();

      rows.forEach(row=>{
        const e = Number(row.easting_m), n = Number(row.northing_m);
        if(!Number.isFinite(e) || !Number.isFinite(n)) return;

        const [lat,lon] = utmToLatLon(e,n,29,true);
        const statusKey = String(row.status || "").toLowerCase();

        let fill = "#d8b451";
        if(statusKey === "completed") fill = "#54a77b";
        if(statusKey === "planned") fill = "#8fb7ff";
        if(statusKey === "proposed") fill = "#e0a25d";

        const marker = L.circleMarker([lat,lon],{
          radius:6,
          weight:2,
          color:"#f4f7f5",
          fillColor:fill,
          fillOpacity:.92
        });

        const name = row.trench_id || row.drillhole_name || "Tranchée";
        marker._nsourSearch = String(name + " " + (row.drillhole_name || "")).toLowerCase();

        marker.bindPopup(`
          <div class="nsour-popup">
            <b>${esc(name)}</b>
            <table>
              <tr><td>Nom terrain</td><td>${esc(row.drillhole_name)}</td></tr>
              <tr><td>Easting</td><td>${esc(row.easting_m)} m</td></tr>
              <tr><td>Northing</td><td>${esc(row.northing_m)} m</td></tr>
              <tr><td>Longueur cible</td><td>${esc(row.target_length_m)} m</td></tr>
              <tr><td>Longueur réelle</td><td>${esc(row.actual_length_m)} m</td></tr>
              <tr><td>Azimut</td><td>${esc(row.azimuth_deg)}°</td></tr>
              <tr><td>Pendage</td><td>${esc(row.dip_deg)}°</td></tr>
              <tr><td>Statut</td><td>${esc(row.status)}</td></tr>
              <tr><td>Campagne</td><td>${esc(row.campaign)}</td></tr>
              <tr><td>Source</td><td>${esc(sourceLabel)}</td></tr>
            </table>
          </div>
        `);

        marker.addTo(trenchLayer);
        trenchMarkers.push(marker);
      });

      document.getElementById("mapTrenchCount").textContent =
        trenchMarkers.length.toLocaleString("fr-FR");

      status.textContent =
        `Carte active · ${trenchMarkers.length} tranchée(s) cartographiée(s) · ${sourceLabel}`;
    }

    try{
      const params = new URLSearchParams();
      params.set("select","trench_id,drillhole_name,easting_m,northing_m,elevation_m,azimuth_deg,dip_deg,target_length_m,actual_length_m,status,campaign,notes");
      params.set("permit_key","eq.NSOUR");
      params.set("order","trench_id.asc");

      const res = await fetch(API + "/explorer_trenches?" + params.toString(), {
        headers:{"Accept":"application/json"}
      });

      if(!res.ok) throw new Error("HTTP " + res.status);

      const rows = await res.json();
      if(!Array.isArray(rows)) throw new Error("Réponse inattendue");

      const valid = rows.filter(r =>
        Number.isFinite(Number(r.easting_m)) &&
        Number.isFinite(Number(r.northing_m))
      );

      if(!valid.length) throw new Error("Aucune tranchée géoréférencée retournée");

      drawRows(valid, "Neon");
    }catch(err){
      drawRows(FALLBACK_TRENCHES, "référentiel Nsour intégré");
    }
  }

  async function loadPits(){
    const rows = FALLBACK_PITS;
    pitMarkers = [];
    pitLayer.clearLayers();

    rows.forEach(row=>{
      const e = Number(row.easting_m), n = Number(row.northing_m);
      if(!Number.isFinite(e) || !Number.isFinite(n)) return;

      const [lat,lon] = utmToLatLon(e,n,29,true);
      const marker = L.circleMarker([lat,lon],{
        radius:5,
        weight:2,
        color:"#fff2ff",
        fillColor:"#d86bd4",
        fillOpacity:.92
      });

      const samples = Array.isArray(row.samples) ? row.samples : [];
      marker._nsourSearch = String(
        (row.pit_id || "") + " " + samples.map(s=>s.sample_id || "").join(" ")
      ).toLowerCase();

      const rowsHtml = samples.map(s => `
        <tr>
          <td>${esc(s.sample_id)}</td>
          <td>${esc(s.rock_vein_type)}</td>
          <td>${esc(s.depth_m)} m</td>
        </tr>`).join("");

      marker.bindPopup(`
        <div class="nsour-popup">
          <b>${esc(row.pit_id)}</b>
          <div style="margin:4px 0 7px;color:#60756b">${samples.length} échantillon(s)</div>
          <table>
            <tr><td>Easting</td><td>${esc(row.easting_m)} m</td></tr>
            <tr><td>Northing</td><td>${esc(row.northing_m)} m</td></tr>
          </table>
          <table style="margin-top:7px">
            <tr><td><b>Échantillon</b></td><td><b>Type</b></td><td><b>Prof.</b></td></tr>
            ${rowsHtml}
          </table>
        </div>
      `);

      marker.addTo(pitLayer);
      pitMarkers.push(marker);
    });

    document.getElementById("mapPitCount").textContent =
      pitMarkers.length.toLocaleString("fr-FR");
  }

  async function loadAu(){
    const rows = FALLBACK_GH_AU;
    auMarkers = [];
    auLayer.clearLayers();

    function auColor(v){
      const x = Number(v);
      if(!Number.isFinite(x)) return "#b8c3bf";
      if(x >= 0.50) return "#ff5f57";
      if(x >= 0.10) return "#ffb347";
      return "#c7d95b";
    }

    rows.forEach(row=>{
      const e = Number(row.easting_m), n = Number(row.northing_m);
      if(!Number.isFinite(e) || !Number.isFinite(n)) return;

      const [lat,lon] = utmToLatLon(e,n,29,true);
      const maxAu = Number(row.max_au_ppm);

      const marker = L.circleMarker([lat,lon],{
        radius:9,
        weight:3,
        color:auColor(maxAu),
        fillColor:"#07120f",
        fillOpacity:.12
      });
      marker._auValue = maxAu;
      marker._auCategory =
        !Number.isFinite(maxAu) ? "unknown" :
        maxAu >= 0.50 ? "high" :
        maxAu >= 0.10 ? "medium" : "low";

      marker._nsourSearch = String(
        (row.trench_id || "") + " " +
        (row.drillhole_name || "") + " " +
        (row.samples || []).map(s=>s.sample_id || "").join(" ")
      ).toLowerCase();

      const sampleRows = (row.samples || []).map(s=>`
        <tr>
          <td>${esc(s.sample_id)}</td>
          <td>${esc(s.au_reported_text)} ppm</td>
          <td>${esc(s.from_m)}–${esc(s.to_m)} m</td>
          <td>${esc(s.description)}</td>
        </tr>`).join("");

      marker.bindPopup(`
        <div class="nsour-popup">
          <b>${esc(row.trench_id)} — Au (GH)</b>
          <div style="margin:4px 0 7px;color:#60756b">
            Position affichée = point de référence de la tranchée, car les GH n'ont pas de coordonnées propres dans le jeu disponible.
          </div>
          <table>
            <tr><td>Nom terrain</td><td>${esc(row.drillhole_name)}</td></tr>
            <tr><td>Au max GH</td><td><b>${esc(row.max_au_ppm)} ppm</b></td></tr>
          </table>
          <table style="margin-top:7px">
            <tr><td><b>Échantillon</b></td><td><b>Au</b></td><td><b>Intervalle</b></td><td><b>Description</b></td></tr>
            ${sampleRows}
          </table>
        </div>
      `);

      marker.addTo(auLayer);
      auMarkers.push(marker);
    });

    document.getElementById("mapAuCount").textContent =
      auMarkers.length.toLocaleString("fr-FR");

    const finiteAu = auMarkers
      .map(m => m._auValue)
      .filter(v => Number.isFinite(v));
    const maxAu = finiteAu.length ? Math.max(...finiteAu) : null;
    document.getElementById("mapAuMax").textContent =
      maxAu === null ? "—" : maxAu.toFixed(2).replace(".", ",");

    applyAuFilter();
  }

  function applyAuFilter(){
    if(!auLayer) return;
    const mode = document.getElementById("auFilter")?.value || "all";
    auLayer.clearLayers();

    let visible = 0;
    auMarkers.forEach(marker=>{
      if(mode === "all" || marker._auCategory === mode){
        marker.addTo(auLayer);
        visible++;
      }
    });

    const count = document.getElementById("mapAuCount");
    if(count){
      count.textContent = mode === "all"
        ? auMarkers.length.toLocaleString("fr-FR")
        : `${visible}/${auMarkers.length}`;
    }
  }

  function renderRcPanel(query=""){
    const q = String(query || "").trim().toLowerCase();
    const data = RC_CONCHITA_DATA.filter(r => {
      if(!q) return true;
      return String(r.hole_id || "").toLowerCase().includes(q)
        || String(r.zone_name || "").toLowerCase().includes(q);
    });

    const holes = RC_CONCHITA_DATA.length;
    const allGrades = [];
    RC_CONCHITA_DATA.forEach(r=>{
      (r.reassays || []).forEach(x=>{
        const v = Number(x.au_ppm);
        if(Number.isFinite(v)) allGrades.push(v);
      });
      (r.intercepts || []).forEach(x=>{
        const v = Number(x.au_grade_ppm);
        if(Number.isFinite(v)) allGrades.push(v);
      });
    });
    const maxAu = allGrades.length ? Math.max(...allGrades) : null;
    const summary = document.getElementById("rcSummary");
    if(summary){
      summary.innerHTML =
        `Forages documentés : <b>${holes}</b><br>` +
        `Au max documenté : <b>${maxAu === null ? "—" : maxAu.toFixed(2)} g/t</b><br>` +
        `Position cartographique : <b>non disponible</b>`;
    }

    const box = document.getElementById("rcResults");
    if(!box) return;
    box.innerHTML = data.map(r=>{
      const rows = [];
      (r.reassays || []).forEach(x=>{
        rows.push(`
          <tr>
            <td>Réanalyse</td>
            <td>${esc(x.from_m)}–${esc(x.to_m)} m</td>
            <td>${esc(x.au_reported_text)} g/t</td>
            <td>${esc(x.quartz_description)}</td>
            <td>${esc(x.sample_id)}</td>
          </tr>`);
      });
      (r.intercepts || []).forEach(x=>{
        rows.push(`
          <tr>
            <td>Intercept</td>
            <td>${esc(x.from_m)}–${esc(x.to_m)} m</td>
            <td>${esc(x.au_grade_ppm)} g/t</td>
            <td>${esc(x.thickness_calc_m)} m</td>
            <td>${x.note ? "note*" : "—"}</td>
          </tr>`);
      });
      return `
        <details class="rc-result">
          <summary>${esc(r.hole_id)} <span class="rc-badge">${esc(r.zone_name)}</span></summary>
          <table>
            <tr><th>Type</th><th>Intervalle</th><th>Au</th><th>Quartz/ép.</th><th>Échantillon</th></tr>
            ${rows.join("")}
          </table>
        </details>`;
    }).join("") || '<div class="map-coordinate">Aucun forage correspondant.</div>';
  }

  function ensureMap(){
    if(initialized || typeof L === "undefined") return;
    initialized = true;

    const permitLatLng = permitUTM.map(([e,n])=>utmToLatLon(e,n,29,true));

    map = L.map("nsourMap",{
      zoomControl:true,
      preferCanvas:true
    });

    const osm = L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{
      maxZoom:19,
      attribution:"© OpenStreetMap"
    });

    const satellite = L.tileLayer(
      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      {maxZoom:19, attribution:"Esri World Imagery"}
    );

    satellite.addTo(map);

    permitLayer = L.polygon(permitLatLng,{
      color:"#f0d67a",
      weight:3,
      fillColor:"#d8b451",
      fillOpacity:.08
    }).bindPopup("<b>Permis Nsour 2919</b><br>371 km²<br>WGS84 / UTM 29N").addTo(map);

    trenchLayer = L.layerGroup().addTo(map);
    pitLayer = L.layerGroup().addTo(map);
    auLayer = L.layerGroup().addTo(map);

    L.control.layers(
      {"Satellite":satellite,"OpenStreetMap":osm},
      {"Limite du permis":permitLayer,"Tranchées":trenchLayer,"Puits / échantillons":pitLayer,"Au — GH":auLayer},
      {collapsed:false}
    ).addTo(map);

    map.fitBounds(permitLayer.getBounds(),{padding:[20,20]});

    document.getElementById("togglePermit")?.addEventListener("change",e=>{
      if(e.target.checked) permitLayer.addTo(map); else map.removeLayer(permitLayer);
    });
    document.getElementById("toggleTrenches")?.addEventListener("change",e=>{
      if(e.target.checked) trenchLayer.addTo(map); else map.removeLayer(trenchLayer);
    });
    document.getElementById("togglePits")?.addEventListener("change",e=>{
      if(e.target.checked) pitLayer.addTo(map); else map.removeLayer(pitLayer);
    });
    document.getElementById("toggleAu")?.addEventListener("change",e=>{
      if(e.target.checked) auLayer.addTo(map); else map.removeLayer(auLayer);
    });
    document.getElementById("auFilter")?.addEventListener("change",()=>{
      applyAuFilter();
      if(!map.hasLayer(auLayer)) auLayer.addTo(map);
      const toggle = document.getElementById("toggleAu");
      if(toggle) toggle.checked = true;
    });
    document.getElementById("openRcPanel")?.addEventListener("click",()=>{
      const p = document.getElementById("rcPanel");
      if(p){ p.classList.add("open"); renderRcPanel(""); }
    });
    document.getElementById("closeRcPanel")?.addEventListener("click",()=>{
      document.getElementById("rcPanel")?.classList.remove("open");
    });
    document.getElementById("rcSearch")?.addEventListener("input",e=>{
      renderRcPanel(e.target.value);
    });

    document.getElementById("mapSearch")?.addEventListener("input",e=>{
      const q = e.target.value.trim().toLowerCase();
      if(!q) return;
      const m = trenchMarkers.find(x => x._nsourSearch.includes(q))
             || pitMarkers.find(x => x._nsourSearch.includes(q))
             || auMarkers.find(x => x._nsourSearch.includes(q));
      if(m){
        if(trenchMarkers.includes(m) && !map.hasLayer(trenchLayer)) trenchLayer.addTo(map);
        if(pitMarkers.includes(m) && !map.hasLayer(pitLayer)) pitLayer.addTo(map);
        if(auMarkers.includes(m) && !map.hasLayer(auLayer)) auLayer.addTo(map);
        map.setView(m.getLatLng(),15);
        m.openPopup();
      }
    });

    map.on("mousemove",e=>{
      const coord = document.getElementById("mapCoordinate");
      if(coord) coord.innerHTML =
        `Latitude : <b>${e.latlng.lat.toFixed(6)}</b><br>`+
        `Longitude : <b>${e.latlng.lng.toFixed(6)}</b><br>`+
        `Référence affichée : WGS84`;
    });

    loadTrenches();
    loadPits();
    loadAu();
    setTimeout(()=>map.invalidateSize(),120);
  }

  const mapBtn = document.querySelector('nav button[data-page="map"]');
  mapBtn?.addEventListener("click",()=>{
    setTimeout(()=>{
      ensureMap();
      if(map) map.invalidateSize();
    },60);
  });
})();
</script>

</body>
</html>
